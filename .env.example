# Hostinger SMTP — used by /api/contact to relay form submissions
# Copy this file to .env.local for local dev (do not commit .env.local)
# In production, configure these in Vercel → Project → Settings → Environment Variables

SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=hello@usestudiocora.com
SMTP_PASS=your-mailbox-password
# Optional — defaults to SMTP_USER if not set
SMTP_TO=hello@usestudiocora.com

# Sanity CMS — painel editorial em /admin
NEXT_PUBLIC_SANITY_PROJECT_ID=your-project-id
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2026-09-02
# Token Viewer usado somente no servidor para visualizar rascunhos
SANITY_API_READ_TOKEN=your-viewer-token
# Segredo compartilhado pelo webhook de publicação
SANITY_REVALIDATE_SECRET=generate-a-long-random-secret
